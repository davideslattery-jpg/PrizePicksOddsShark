# Primary (recommended): OddsPapi — https://oddspapi.io/
ODDSPAPI_API_KEY=your_oddspapi_key_here

# Legacy / optional: The Odds API — https://the-odds-api.com/
# ODDS_API_KEY=your_the_odds_api_key_here

# Optional: override disk cache directory (default: .odds_cache in cwd)
# ODDS_CACHE_DIR=.odds_cache

# Optional: cache TTL seconds for fixtures/odds (default: 480 = 8 minutes)
# ODDS_CACHE_TTL=480
